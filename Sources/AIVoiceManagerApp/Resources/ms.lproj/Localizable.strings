"h.providers.t" = "Penyedia AI";
"h.providers.d" = "Sebelah kiri, bahagian bawah rel (seperti Penampilan di sebelah kanan). Ada dua tab. Suara: sambung Google (kunci API Gemini, diuji dan disimpan untuk setiap projek); suara Apple memberi setiap babak Pratonton pantas percuma. Ejen AI: pilih AI yang menjawab sembang dan menulis semula babak — Apple, Ollama, OpenAI, Gemini atau Claude. Terbuka sendiri sehingga Google disambungkan.";
"h.projects.t" = "Projek Terkini";
"h.projects.d" = "Sebelah kiri: projek yang anda buka sebelum ini. Cari mengikut nama, klik untuk membuka. Buka Projek… membawa masuk projek yang dieksport dari Mac lain. Projek disimpan secara automatik; Eksport Projek (bar alat) membuat fail untuk dibawa bersama anda.";
"h.model.t" = "Model";
"h.model.d" = "Setiap projek menggunakan satu model Gemini TTS, dipilih semasa anda menciptanya dan ditunjukkan di bawah nama. Tukar menerangkan apa yang berubah: pratonton babak perlu dijana semula, sokongan Thai dan harga turut berubah; babak, suara dan rakaman lama kekal.";
"h.timeline.t" = "Garis Masa Skrip";
"h.timeline.d" = "Setiap baris (Skrip) dan setiap nafas atau jeda (Ekspresi) ialah satu babak. Seret ⋮⋮ untuk menyusun semula, {speaker.slash} untuk mengecualikan babak daripada rakaman, klik untuk menyuntingnya di sebelah kanan.";
"h.scene.t" = "Babak Semasa";
"h.scene.d" = "Skrip: suara (seret dari Pustaka Suara), gaya (seret dari tab Gaya atau taip), teks, dan pratonton babak ini sahaja (Jana pratonton → Sedia → Main). Ekspresi: yang semasa; tukar dari Pustaka Ekspresi.";
"h.exprs.t" = "Pustaka Ekspresi";
"h.exprs.d" = "Sebelah kanan. Nafas, jeda, ketawa, keluhan, tercungap, batuk. Seret ke garis masa untuk menyisip, ke Babak Semasa untuk menukar, atau tekan Guna.";
"h.history.t" = "Sejarah";
"h.history.d" = "Sebelah kanan, atas. Dua tab, setiap satu 30. Skrip: suntingan terakhir projek yang dibuka, terbaharu dahulu; {pin.fill} menyemat versi, dan projek semasa dibuka disematkan untuk anda. Babak: versi teks babak — kembali hanya menukar babak itu. Klik dua kali satu baris atau tekan ↩ untuk kembali — kembali juga merupakan langkah baharu, jadi tiada yang hilang. Setiap projek ada Sejarahnya sendiri.";
"h.gen.t" = "Jana";
"h.gen.d" = "Sebelah kanan. Pratonton seluruh projek (setiap babak yang tidak disenyapkan), model, Jana dengan Gemini (⌘↵), kemudian main, muat turun atau padam setiap hasil.";
"h.voices.t" = "Pustaka Suara";
"h.voices.d" = "30 suara Gemini TTS. Cari, seret suara ke babak atau tekan Guna.";
"h.ai.t" = "Ejen AI";
"h.ai.d" = "Tanya Ejen AI tentang projek: ayat pembuka yang lebih baik, di mana perlu berjeda, terjemahan. Pilih AI yang menjawab — Apple, Ollama, OpenAI, Gemini atau Claude — melalui ⚙ atau dalam Penyedia AI › Ejen AI. Ia menjawab; anda sendiri yang menukar babak.";

