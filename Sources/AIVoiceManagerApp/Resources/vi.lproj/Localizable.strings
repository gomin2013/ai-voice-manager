"q.en" = "Dịch dự án sang tiếng Anh";
"q.style" = "Gợi ý giọng điệu cho từng cảnh";
"h.providers.t" = "Nhà cung cấp AI";
"h.providers.d" = "Bên trái, cuối thanh bên (giống Giao diện ở bên phải). Có hai thẻ. Giọng: kết nối Google (khóa API Gemini, được kiểm tra và dùng cho mọi dự án); giọng Apple cho mỗi cảnh một bản Nghe nhanh miễn phí. Trợ lý AI: chọn AI trả lời trò chuyện và viết lại cảnh — Apple, Ollama, OpenAI, Gemini hoặc Claude. Tự mở cho đến khi Google được kết nối.";
"h.projects.t" = "Dự án gần đây";
"h.projects.d" = "Bên trái: các dự án bạn đã mở trước đây. Tìm theo tên, nhấp để mở. Mở dự án… nhập một dự án được xuất từ máy Mac khác. Dự án được lưu tự động; Xuất dự án (thanh công cụ) tạo tệp để mang đi.";
"h.model.t" = "Mô hình";
"h.model.d" = "Mỗi dự án dùng một mô hình Gemini TTS, được chọn khi tạo và hiển thị dưới tên. Đổi cho biết điều gì thay đổi: bản nghe thử của các cảnh cần tạo lại, hỗ trợ tiếng Thái và giá theo mô hình mới; các cảnh, giọng và bản thu cũ được giữ nguyên.";
"h.timeline.t" = "Dòng thời gian kịch bản";
"h.timeline.d" = "Mỗi câu (Kịch bản) và mỗi hơi thở hay khoảng ngắt (Biểu cảm) là một cảnh. Kéo ⋮⋮ để sắp xếp lại, {speaker.slash} để bỏ một cảnh khỏi bản thu, nhấp để sửa ở bên phải.";
"h.scene.t" = "Cảnh hiện tại";
"h.scene.d" = "Kịch bản: giọng (kéo từ Thư viện giọng), giọng điệu (kéo từ tab Giọng điệu hoặc tự nhập), văn bản, và bản nghe thử chỉ của cảnh này (Tạo bản nghe thử → Sẵn sàng → Phát). Biểu cảm: biểu cảm hiện tại; đổi từ Thư viện biểu cảm.";
"h.exprs.t" = "Thư viện biểu cảm";
"h.exprs.d" = "Bên phải. Hơi thở, khoảng ngắt, cười, thở dài, hít mạnh, ho. Kéo vào dòng thời gian để chèn, vào Cảnh hiện tại để thay đổi, hoặc nhấn Áp dụng.";
"h.history.t" = "Lịch sử";
"h.history.d" = "Bên phải, trên cùng. Hai thẻ, mỗi thẻ 30 mục. Kịch bản: các thay đổi gần nhất của dự án đang mở, mới nhất trước; {pin.fill} ghim một phiên bản, phiên bản lúc mở dự án được ghim sẵn. Cảnh: các phiên bản văn bản của cảnh — quay lại chỉ thay đổi cảnh đó. Nhấp đúp vào một dòng hoặc nhấn ↩ để quay lại — quay lại cũng là một bước mới, nên không có gì bị mất. Mỗi dự án có Lịch sử riêng.";
"h.gen.t" = "Tạo âm thanh";
"h.gen.d" = "Bên phải. Nghe thử cả dự án (mọi cảnh không bị tắt tiếng), mô hình, Tạo âm thanh bằng Gemini (⌘↵), rồi phát, tải về hoặc xóa từng kết quả.";
"h.voices.t" = "Thư viện giọng";
"h.voices.d" = "30 giọng Gemini TTS. Tìm kiếm, kéo một giọng vào cảnh hoặc nhấn Áp dụng.";
"h.ai.t" = "Trợ lý AI";
"h.ai.d" = "Hỏi Trợ lý AI về dự án: câu mở đầu hay hơn, nên ngắt ở đâu, một bản dịch. Chọn AI trả lời — Apple, Ollama, OpenAI, Gemini hoặc Claude — bằng ⚙ hoặc trong Nhà cung cấp AI › Trợ lý AI. AI chỉ trả lời; bạn tự thay đổi các cảnh.";

